<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Private=false: the host provides Aether.SDK; the plugin must not ship its own copy. -->
    <ProjectReference Include="..\..\src\Aether.SDK\Aether.SDK.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="aether-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
