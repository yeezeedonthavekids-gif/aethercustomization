<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Aether.App</RootNamespace>
    <AssemblyName>Aether</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <!-- Unpackaged, self-contained Windows App SDK: runs without installing the WinAppSDK runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(XamlNoContent)' != 'true'">Assets\aether.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup Condition="'$(XamlRefTest)' == ''">
    <ProjectReference Include="..\Aether.Presentation\Aether.Presentation.csproj" />
    <ProjectReference Include="..\Aether.WindowsIntegration\Aether.WindowsIntegration.csproj" />
  </ItemGroup>
  <!-- Diagnostics: reference a single library (plus its dependencies) to find what the XAML compiler can't load. -->
  <ItemGroup Condition="'$(XamlRefTest)' != '' and '$(XamlRefTest)' != 'none'">
    <ProjectReference Include="..\Aether.$(XamlRefTest)\Aether.$(XamlRefTest).csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(XamlNoContent)' != 'true'">
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\marketplace\**\*" LinkBase="Marketplace" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Diagnostics: compile a single XAML page (used by CI to bisect XAML compiler crashes). -->
  <ItemGroup Condition="'$(XamlNoTheme)' == 'true'">
    <Page Remove="Themes\Aether.xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(XamlOnly)' != ''">
    <Page Remove="Views\*.xaml" />
    <Page Include="$(XamlOnly)" Condition="'$(XamlOnly)' != 'none'" />
  </ItemGroup>
  <ItemGroup Condition="'$(XamlMinApp)' == 'true'">
    <ApplicationDefinition Remove="App.xaml" />
    <Page Remove="App.xaml" />
    <ApplicationDefinition Include="Diagnostics\AppMin.xaml" />
  </ItemGroup>
  <!-- Diagnostic pages are only compiled when selected with -p:XamlOnly=Diagnostics\X.xaml. -->
  <ItemGroup>
    <Page Remove="Diagnostics\**\*.xaml" />
    <None Include="Diagnostics\**\*.xaml" />
    <Compile Remove="Diagnostics\**\*.cs" Condition="'$(XamlOnly)' == '' or !$(XamlOnly.StartsWith('Diagnostics'))" />
  </ItemGroup>
</Project>
