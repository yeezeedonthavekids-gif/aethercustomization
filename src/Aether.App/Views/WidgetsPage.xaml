<UserControl x:Class="Aether.App.Views.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Aether.App"
    xmlns:ctl="using:Aether.App.Controls"
    xmlns:vm="using:Aether.Presentation.ViewModels"
    xmlns:items="using:Aether.Presentation.Items"
    xmlns:we="using:Aether.WidgetEngine">
    <Grid Padding="36,8,24,24" ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="400" /></Grid.ColumnDefinitions>
        <ScrollViewer>
            <StackPanel Spacing="14">
                <Border Style="{StaticResource AeCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Show widgets on the desktop" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                            <TextBlock Text="Runs the Desktop Widget Manager mod. Widgets are independent AETHER windows; drag to move, resize from the corner." Style="{StaticResource AeCaption}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AeAccentButton}" Content="Turn on / off" Command="{x:Bind ViewModel.ToggleHostCommand}" />
                    </Grid>
                </Border>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Layout" Style="{StaticResource AeSectionTitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Layouts}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.ActiveLayout, Mode=TwoWay}" MinWidth="220" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource AeButton}" Content="Manage">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="New layout…" Command="{x:Bind ViewModel.NewLayoutCommand}" />
                                <MenuFlyoutItem Text="Rename…" Command="{x:Bind ViewModel.RenameLayoutCommand}" />
                                <MenuFlyoutItem Text="Export…" Command="{x:Bind ViewModel.ExportLayoutCommand}" />
                                <MenuFlyoutItem Text="Import…" Command="{x:Bind ViewModel.ImportLayoutCommand}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete layout" Command="{x:Bind ViewModel.DeleteLayoutCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <ListView ItemsSource="{x:Bind ViewModel.Widgets}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:WidgetInstanceItem">
                            <Grid Padding="4,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource AeIcons}" Foreground="{StaticResource AeAccent}" />
                                <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Name}" Foreground="{StaticResource AeText}" /><TextBlock Text="{x:Bind Summary}" Style="{StaticResource AeMuted}" /></StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="This layout is empty — add a widget below." Style="{StaticResource AeMuted}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                <TextBlock Text="Widget gallery" Style="{StaticResource AeSectionTitle}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Catalog}">
                    <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="200" MinItemHeight="120" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="we:WidgetDefinition">
                            <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="14" CornerRadius="14"
                                    Background="{StaticResource AeSurface}" BorderBrush="{StaticResource AeBorder}" Click="OnAdd" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind DataSource}">
                                <StackPanel Spacing="6">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource AeIcons}" FontSize="20" Foreground="{StaticResource AeAccent}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource AeMuted}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" Style="{StaticResource AeCardElevated}" Padding="0">
            <Grid>
                <TextBlock Text="Select a widget to customize it" Style="{StaticResource AeCaption}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind app:B.Hide(ViewModel.HasSelection), Mode=OneWay}" />
                <ScrollViewer Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Padding="20" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Definition.DataSource, Mode=OneWay}" Style="{StaticResource AeMuted}" />
                        <ctl:SettingsFormView Form="{x:Bind ViewModel.WidgetForm, Mode=OneWay}" />
                        <TextBlock Text="Appearance" Style="{StaticResource AeSectionTitle}" />
                        <TextBox Header="Background" Text="{x:Bind ViewModel.Background, Mode=TwoWay}" Style="{StaticResource AeTextBox}" />
                        <Slider Header="Opacity" Minimum="0.2" Maximum="1" StepFrequency="0.02" Value="{x:Bind ViewModel.Opacity, Mode=TwoWay}" />
                        <Slider Header="Corner radius" Minimum="0" Maximum="32" Value="{x:Bind ViewModel.CornerRadius, Mode=TwoWay}" />
                        <TextBox Header="Text color" Text="{x:Bind ViewModel.TextColor, Mode=TwoWay}" Style="{StaticResource AeTextBox}" />
                        <TextBox Header="Accent color" Text="{x:Bind ViewModel.AccentColor, Mode=TwoWay}" Style="{StaticResource AeTextBox}" />
                        <ComboBox Header="Font" ItemsSource="{x:Bind ViewModel.Fonts}" SelectedItem="{x:Bind ViewModel.FontFamily, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <NumberBox Header="Width" Value="{x:Bind ViewModel.Width, Mode=TwoWay}" Minimum="100" Maximum="1600" Width="110" />
                            <NumberBox Header="Height" Value="{x:Bind ViewModel.Height, Mode=TwoWay}" Minimum="80" Maximum="1200" Width="110" />
                            <NumberBox Header="Refresh (s)" Value="{x:Bind ViewModel.RefreshSeconds, Mode=TwoWay}" Minimum="1" Maximum="3600" Width="110" />
                        </StackPanel>
                        <ToggleSwitch Header="Blur behind" IsOn="{x:Bind ViewModel.Blur, Mode=TwoWay}" />
                        <ToggleSwitch Header="Always on top" IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" />
                        <ToggleSwitch Header="Visible" IsOn="{x:Bind ViewModel.Visible, Mode=TwoWay}" />
                        <ToggleSwitch Header="Lock position" IsOn="{x:Bind ViewModel.Locked, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AeAccentButton}" Content="Save widget" Command="{x:Bind ViewModel.SaveSelectedCommand}" />
                            <Button Style="{StaticResource AeButton}" Content="Remove" Command="{x:Bind ViewModel.RemoveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
