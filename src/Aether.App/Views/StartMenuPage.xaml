<UserControl x:Class="Aether.App.Views.StartMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Aether.App"
    xmlns:ctl="using:Aether.App.Controls"
    xmlns:vm="using:Aether.Presentation.ViewModels"
    xmlns:items="using:Aether.Presentation.Items"
    xmlns:apps="using:Aether.Services.Applications">
    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" Spacing="14">
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="About the Start menu"
                     Message="Windows offers no supported API to redesign its Start menu. AETHER changes the native options below, and provides its own launcher — an independent window you open with a shortcut." />
            <Grid>
                <TextBlock Text="AETHER launcher layouts" Style="{StaticResource AeSectionTitle}" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource AeCaption}"><Run Text="Shortcut: " /><Run Text="{x:Bind ViewModel.LauncherHotkey}" /></TextBlock>
                    <Button Style="{StaticResource AeAccentButton}" Content="Open launcher" Command="{x:Bind ViewModel.OpenLauncherCommand}" />
                </StackPanel>
            </Grid>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Profiles}">
                <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="230" MinItemHeight="110" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:StartProfileItem">
                        <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="16" CornerRadius="14"
                                Background="{StaticResource AeSurface}" BorderBrush="{StaticResource AeBorder}" Click="OnProfileClick" Tag="{x:Bind}">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="{x:Bind StyleLabel}" FontSize="11" Foreground="{StaticResource AeAccent}" />
                                    <Border Style="{StaticResource AeChip}" HorizontalAlignment="Right" Visibility="{x:Bind IsActive, Mode=OneWay}"><TextBlock Text="Active" FontSize="11" /></Border>
                                </Grid>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource AeMuted}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock Text="Customize the active layout" Style="{StaticResource AeSectionTitle}" />
            <Border Style="{StaticResource AeCard}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <NumberBox Header="Columns" Minimum="1" Maximum="12" Value="{x:Bind ViewModel.Columns, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Width="120" />
                        <Slider Header="Icon size" Minimum="20" Maximum="80" Value="{x:Bind ViewModel.IconSize, Mode=TwoWay}" Width="180" />
                        <Slider Header="Spacing" Minimum="0" Maximum="32" Value="{x:Bind ViewModel.Spacing, Mode=TwoWay}" Width="180" />
                        <Slider Header="Opacity" Minimum="0.4" Maximum="1" StepFrequency="0.02" Value="{x:Bind ViewModel.Opacity, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <ToggleSwitch Header="Search box" IsOn="{x:Bind ViewModel.ShowSearch, Mode=TwoWay}" />
                        <ToggleSwitch Header="Recent apps" IsOn="{x:Bind ViewModel.ShowRecent, Mode=TwoWay}" />
                        <ToggleSwitch Header="Categories" IsOn="{x:Bind ViewModel.ShowCategories, Mode=TwoWay}" />
                        <ToggleSwitch Header="Blur" IsOn="{x:Bind ViewModel.Blur, Mode=TwoWay}" />
                        <ComboBox Header="Background" ItemsSource="{x:Bind ViewModel.Backgrounds}" SelectedItem="{x:Bind ViewModel.Background, Mode=TwoWay}" MinWidth="120" />
                    </StackPanel>
                    <TextBlock Text="Pinned apps" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox ItemsSource="{x:Bind ViewModel.AllApps}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.AppToPin, Mode=TwoWay}" MinWidth="280" PlaceholderText="Choose an app" />
                        <Button Style="{StaticResource AeButton}" Content="Pin" Command="{x:Bind ViewModel.PinCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PinnedApps}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="190" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="apps:InstalledApp">
                                <Border Margin="0,0,8,8" Padding="10,6" CornerRadius="10" Background="{StaticResource AeSurfaceHover}">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Name}" MaxWidth="130" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource AeText}" />
                                        <Button HorizontalAlignment="Right" Style="{StaticResource AeGhostButton}" Padding="4" Click="OnUnpin" Tag="{x:Bind}">
                                            <FontIcon Glyph="&#xE711;" FontSize="11" FontFamily="{StaticResource AeIcons}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource AeAccentButton}" Content="Save layout" Command="{x:Bind ViewModel.SaveLauncherCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <TextBlock Text="Native Start menu settings" Style="{StaticResource AeSectionTitle}" />
            <ctl:TweakListView Group="{x:Bind ViewModel.Native}" />
            <TextBlock Text="Start menu mods" Style="{StaticResource AeSectionTitle}" />
            <ctl:ModCardsView x:Name="Mods" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
