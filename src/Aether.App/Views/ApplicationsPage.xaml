<UserControl x:Class="Aether.App.Views.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Aether.App"
    xmlns:ctl="using:Aether.App.Controls"
    xmlns:vm="using:Aether.Presentation.ViewModels"
    xmlns:items="using:Aether.Presentation.Items"
    xmlns:apps="using:Aether.Services.Applications">
    <Pivot Margin="24,0,24,0">
        <PivotItem Header="Apps">
            <Grid RowSpacing="12" Margin="0,8,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="Search applications" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AeTextBox}" />
                    <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.Category, Mode=TwoWay}" MinWidth="170" />
                    <Button Grid.Column="2" Style="{StaticResource AeButton}" Content="Rescan" Command="{x:Bind ViewModel.RescanCommand}" />
                    <Button Grid.Column="3" Style="{StaticResource AeButton}" Content="Add app…" Command="{x:Bind ViewModel.AddCustomAppCommand}" />
                </Grid>
                <StackPanel Grid.Row="1" Spacing="6" Visibility="{x:Bind app:B.ShowCount(ViewModel.Favorites.Count), Mode=OneWay}">
                    <TextBlock Text="Favorites" Style="{StaticResource AeSectionTitle}" Margin="0" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Favorites}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppItem">
                                <Button Style="{StaticResource AeButton}" Content="{x:Bind Name}" Click="OnLaunch" Tag="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <GridView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Apps}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAppClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppItem">
                            <Grid Width="200" Height="64" Padding="10" ColumnSpacing="10" CornerRadius="12" Background="{StaticResource AeSurface}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Open" Click="OnLaunch" Tag="{x:Bind}" />
                                        <MenuFlyoutItem Text="Run as administrator" Click="OnLaunchAdmin" Tag="{x:Bind}" />
                                        <MenuFlyoutItem Text="Toggle favorite" Click="OnFavorite" Tag="{x:Bind}" />
                                        <MenuFlyoutItem Text="Set category…" Click="OnCategory" Tag="{x:Bind}" />
                                        <MenuFlyoutItem Text="Custom icon…" Click="OnIcon" Tag="{x:Bind}" />
                                        <MenuFlyoutItem Text="New launch profile…" Click="OnProfile" Tag="{x:Bind}" />
                                        <MenuFlyoutItem Text="Hide" Click="OnHide" Tag="{x:Bind}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AeAccentGradient}">
                                    <TextBlock Text="{x:Bind Initial}" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource AeOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource AeText}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Category}" Style="{StaticResource AeMuted}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </PivotItem>
        <PivotItem Header="Startup">
            <ScrollViewer>
                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock Style="{StaticResource AeCaption}" VerticalAlignment="Center"><Run Text="{x:Bind app:B.Str(ViewModel.StartupEnabledCount), Mode=OneWay}" /><Run Text=" programs start when you sign in. Switching one off works like Task Manager — nothing is deleted." /></TextBlock>
                        <Button HorizontalAlignment="Right" Style="{StaticResource AeButton}" Content="Add startup program…" Command="{x:Bind ViewModel.AddStartupCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Startup}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StartupItem">
                                <Border Style="{StaticResource AeCard}" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                                            <TextBlock Text="{x:Bind Command}" Style="{StaticResource AeMuted}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Source}" FontSize="11" Foreground="{StaticResource AeAccent}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                                        <Button Grid.Column="2" Style="{StaticResource AeGhostButton}" Visibility="{x:Bind CanRemove}" Click="OnRemoveStartup" Tag="{x:Bind}"><FontIcon Glyph="&#xE74D;" FontSize="13" FontFamily="{StaticResource AeIcons}" /></Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
        <PivotItem Header="Profiles &amp; groups">
            <ScrollViewer>
                <StackPanel Spacing="12" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock Text="Launch profiles" Style="{StaticResource AeSectionTitle}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource AeButton}" Content="New profile…" Command="{x:Bind ViewModel.NewProfileCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="apps:LaunchProfile">
                                <Border Style="{StaticResource AeCard}" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                                            <TextBlock Style="{StaticResource AeMuted}"><Run Text="{x:Bind Target}" /><Run Text=" " /><Run Text="{x:Bind Arguments}" /></TextBlock></StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource AeAccentButton}" Content="Launch" Click="OnLaunchProfile" Tag="{x:Bind}" />
                                        <Button Grid.Column="2" Style="{StaticResource AeGhostButton}" Click="OnDeleteProfile" Tag="{x:Bind}"><FontIcon Glyph="&#xE74D;" FontSize="13" FontFamily="{StaticResource AeIcons}" /></Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <TextBlock Text="Quick launch groups" Style="{StaticResource AeSectionTitle}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource AeButton}" Content="New group from favorites…" Command="{x:Bind ViewModel.NewGroupFromFavoritesCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="apps:QuickLaunchGroup">
                                <Border Style="{StaticResource AeCard}" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                                            <TextBlock Style="{StaticResource AeMuted}"><Run Text="{x:Bind app:B.Str(Items.Count)}" /><Run Text=" items" /></TextBlock></StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource AeAccentButton}" Content="Launch all" Click="OnLaunchGroup" Tag="{x:Bind}" />
                                        <Button Grid.Column="2" Style="{StaticResource AeGhostButton}" Click="OnDeleteGroup" Tag="{x:Bind}"><FontIcon Glyph="&#xE74D;" FontSize="13" FontFamily="{StaticResource AeIcons}" /></Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</UserControl>
