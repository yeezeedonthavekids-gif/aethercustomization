<UserControl x:Class="Aether.App.Views.MarketplacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Aether.App"
    xmlns:ctl="using:Aether.App.Controls"
    xmlns:vm="using:Aether.Presentation.ViewModels"
    xmlns:items="using:Aether.Presentation.Items"
    xmlns:mk="using:Aether.Services.Marketplace">
    <Grid Padding="36,8,24,24" ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>
        <Grid RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Search the marketplace" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AeTextBox}" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Sorts}" SelectedItem="{x:Bind ViewModel.Sort, Mode=TwoWay}" MinWidth="140" />
                <Button Grid.Column="2" Style="{StaticResource AeButton}" Content="Refresh" Command="{x:Bind ViewModel.ReloadCommand}" />
                <Button Grid.Column="3" Style="{StaticResource AeButton}" Content="Add source…" Command="{x:Bind ViewModel.AddSourceCommand}" />
            </Grid>
            <StackPanel Grid.Row="1" Spacing="8">
                <ListView ItemsSource="{x:Bind ViewModel.Sections}" SelectedItem="{x:Bind ViewModel.Section, Mode=TwoWay}" SelectionMode="Single" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ListView.ItemsPanel>
                </ListView>
                <InfoBar IsOpen="{x:Bind app:B.ShowCountBool(ViewModel.UpdatesAvailable), Mode=OneWay}" Severity="Success" IsClosable="False" Title="Updates available" Message="Open the Updates section to install them." />
                <TextBlock Text="{x:Bind ViewModel.SectionNote, Mode=OneWay}" Style="{StaticResource AeCaption}" Visibility="{x:Bind app:B.ShowIf(ViewModel.SectionNote), Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.SourceErrors}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" Foreground="{StaticResource AeWarning}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <GridView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Listings}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ListingItem">
                        <Border Width="268" Height="210" CornerRadius="16" Background="{StaticResource AeSurface}" BorderBrush="{StaticResource AeBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="86" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid CornerRadius="16,16,0,0" Background="{x:Bind app:B.Brush(Accent)}" Opacity="0.85">
                                    <Image Source="{x:Bind app:B.Image(Preview, 540)}" Stretch="UniformToFill" />
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="34" FontFamily="{StaticResource AeIcons}" Foreground="White" Visibility="{x:Bind app:B.Hide(HasPreview)}" />
                                </Grid>
                                <StackPanel Grid.Row="1" Padding="14,10" Spacing="3">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{StaticResource AeText}" MaxWidth="170" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                                        <TextBlock Text="{x:Bind Kind}" FontSize="11" Foreground="{StaticResource AeAccent}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource AeMuted}"><Run Text="{x:Bind Author}" /><Run Text=" · v" /><Run Text="{x:Bind Version}" /></TextBlock>
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource AeCaption}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind RatingText}" Style="{StaticResource AeMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AeAccent}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE719;" FontSize="40" FontFamily="{StaticResource AeIcons}" Foreground="{StaticResource AeTextMuted}" />
                <TextBlock Text="Nothing here yet." Style="{StaticResource AeCaption}" HorizontalAlignment="Center" />
                <TextBlock Text="Add a folder or HTTPS source, or drop .aethermod packages into your packages folder." Style="{StaticResource AeMuted}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Border Grid.Column="1" Style="{StaticResource AeCardElevated}" Padding="0">
            <ScrollViewer>
                <StackPanel Padding="20" Spacing="12">
                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AeText}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource AeMuted}"><Run Text="{x:Bind ViewModel.Selected.Author, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.Selected.Source, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.Selected.Description, Mode=OneWay}" Style="{StaticResource AeCaption}" />
                        <TextBlock Style="{StaticResource AeCaption}"><Run Text="Version " /><Run Text="{x:Bind ViewModel.Selected.Version, Mode=OneWay}" /><Run Text=" · updated " /><Run Text="{x:Bind ViewModel.Selected.Updated, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.Selected.Listing.Compatibility, Mode=OneWay}" Style="{StaticResource AeCaption}" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.RatingText, Mode=OneWay}" Style="{StaticResource AeMuted}" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.InstallsText, Mode=OneWay}" Style="{StaticResource AeMuted}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AeAccentButton}" Content="{x:Bind ViewModel.Selected.StateText, Mode=OneWay}" Command="{x:Bind ViewModel.InstallCommand}" IsEnabled="{x:Bind ViewModel.Selected.CanInstall, Mode=OneWay}" />
                            <Button Style="{StaticResource AeButton}" Content="♥ Favorite" Command="{x:Bind ViewModel.ToggleFavoriteCommand}" CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="Permissions" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.PermissionTexts, Mode=OneWay}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" Style="{StaticResource AeCaption}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Changelog" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.Listing.Changelog, Mode=OneWay}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" Style="{StaticResource AeCaption}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="Publishers" Style="{StaticResource AeSectionTitle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Publishers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="mk:PublisherProfile">
                                <HyperlinkButton Click="OnPublisher" Tag="{x:Bind}" Padding="0,2">
                                    <TextBlock><Run Text="{x:Bind Name}" /><Run Text=" (" /><Run Text="{x:Bind app:B.Str(ListingCount)}" /><Run Text=")" /></TextBlock>
                                </HyperlinkButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Sources" Style="{StaticResource AeSectionTitle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MarketplaceSourceView">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource AeText}" />
                                        <TextBlock Style="{StaticResource AeMuted}"><Run Text="{x:Bind Kind}" /><Run Text=" · " /><Run Text="{x:Bind Location}" /></TextBlock>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled}" Toggled="OnSourceToggled" Tag="{x:Bind}" OnContent="" OffContent="" MinWidth="0" />
                                    <Button Grid.Column="2" Style="{StaticResource AeGhostButton}" Visibility="{x:Bind CanRemove}" Click="OnRemoveSource" Tag="{x:Bind}"><FontIcon Glyph="&#xE74D;" FontSize="12" FontFamily="{StaticResource AeIcons}" /></Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
