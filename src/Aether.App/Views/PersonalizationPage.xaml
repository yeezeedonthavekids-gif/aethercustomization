<UserControl x:Class="Aether.App.Views.PersonalizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Aether.App"
    xmlns:ctl="using:Aether.App.Controls"
    xmlns:vm="using:Aether.Presentation.ViewModels"
    xmlns:items="using:Aether.Presentation.Items"
    xmlns:wp="using:Aether.Services.Wallpapers"
    xmlns:core="using:Aether.Core.Abstractions">
    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" Spacing="14">
            <TextBlock Text="Appearance" Style="{StaticResource AeSectionTitle}" />
            <ctl:TweakListView Group="{x:Bind ViewModel.Appearance}" />

            <TextBlock Text="Accent color" Style="{StaticResource AeSectionTitle}" />
            <Border Style="{StaticResource AeCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Pick an accent for Windows. AETHER snapshots your current accent, so 'Restore original' always brings it back." Style="{StaticResource AeCaption}" />
                    <ItemsControl x:Name="AccentSwatches" ItemsSource="{x:Bind ViewModel.AccentPresets}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:Swatch">
                                <Button Width="38" Height="38" CornerRadius="19" Padding="0" Background="{x:Bind app:B.Brush(Hex)}" BorderBrush="{StaticResource AeBorder}" Click="OnSwatchClick" Tag="{x:Bind Hex}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Width="160" Text="{x:Bind ViewModel.CustomAccent, Mode=TwoWay}" Header="Custom (#RRGGBB)" Style="{StaticResource AeTextBox}" />
                        <Button Style="{StaticResource AeAccentButton}" Content="Apply accent" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ApplyAccentCommand}" />
                        <Button Style="{StaticResource AeButton}" Content="Restore original" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.RestoreAccentCommand}" Visibility="{x:Bind ViewModel.AccentCustomized, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Wallpaper" Style="{StaticResource AeSectionTitle}" />
            <Border Style="{StaticResource AeCard}" Visibility="{x:Bind app:B.Hide(ViewModel.WallpaperSupported)}">
                <TextBlock Text="Wallpaper control isn't available on this system." Style="{StaticResource AeCaption}" />
            </Border>
            <Border Style="{StaticResource AeCard}" Visibility="{x:Bind ViewModel.WallpaperSupported}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Choose a monitor, then click an image to set it. Use 'All monitors' for one wallpaper everywhere." Style="{StaticResource AeCaption}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Monitors}" SelectedItem="{x:Bind ViewModel.SelectedMonitor, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate></ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonitorWallpaperViewModel">
                                <StackPanel Spacing="6" Padding="6">
                                    <Border Width="{x:Bind AspectWidth}" Height="{x:Bind AspectHeight}" CornerRadius="10" BorderBrush="{StaticResource AeBorder}" BorderThickness="2" Background="{StaticResource AeSurfaceSolid}">
                                        <Image Source="{x:Bind app:B.Image(CurrentPath, 320), Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Name}" FontSize="12.5" Foreground="{StaticResource AeText}" />
                                    <TextBlock Text="{x:Bind Resolution}" Style="{StaticResource AeMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox Header="Fit" ItemsSource="{x:Bind ViewModel.Fits}" SelectedItem="{x:Bind ViewModel.SelectedFit, Mode=TwoWay}" MinWidth="140" />
                        <Button Style="{StaticResource AeButton}" Content="Browse…" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseWallpaperCommand}" />
                        <Button Style="{StaticResource AeButton}" Content="Add folder" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.AddFolderCommand}" />
                        <Button Style="{StaticResource AeButton}" Content="Save as collection" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SaveCollectionCommand}" />
                        <Button Style="{StaticResource AeButton}" Content="Keep per-monitor wallpapers" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.EnablePerMonitorKeeperCommand}" ToolTipService.ToolTip="Enables the Multi-Monitor Wallpaper Manager mod" />
                    </StackPanel>
                    <GridView ItemsSource="{x:Bind ViewModel.Library}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnWallpaperClick" MaxHeight="440">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WallpaperThumb">
                                <Grid Width="176" Height="110" CornerRadius="10" ToolTipService.ToolTip="{x:Bind Name}">
                                    <Image Stretch="UniformToFill" Source="{x:Bind app:B.Image(Path, 300)}" />
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="6,2" FontSize="11" Content="All monitors" Click="OnAllMonitorsClick" Tag="{x:Bind}" Style="{StaticResource AeButton}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <Expander Header="Online wallpapers" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.OnlineAttribution}" Style="{StaticResource AeCaption}" />
                            <Button Style="{StaticResource AeButton}" Content="Load latest" Command="{x:Bind ViewModel.LoadOnlineCommand}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.OnlineLoading, Mode=OneWay}" HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Bind ViewModel.OnlineError, Mode=OneWay}" Foreground="{StaticResource AeWarning}" Visibility="{x:Bind app:B.ShowIf(ViewModel.OnlineError), Mode=OneWay}" TextWrapping="Wrap" />
                            <GridView ItemsSource="{x:Bind ViewModel.Online}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnOnlineClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="wp:OnlineWallpaper">
                                        <Grid Width="200" Height="112" CornerRadius="10" ToolTipService.ToolTip="{x:Bind Copyright}">
                                            <Image Stretch="UniformToFill" Source="{x:Bind app:B.ImageUri(ThumbnailUrl)}" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <TextBlock Text="Cursors" Style="{StaticResource AeSectionTitle}" />
            <Border Style="{StaticResource AeCard}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox Header="Installed schemes" ItemsSource="{x:Bind ViewModel.CursorSchemes}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.SelectedCursorScheme, Mode=TwoWay}" MinWidth="260" />
                    <Button Style="{StaticResource AeAccentButton}" Content="Apply" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ApplyCursorSchemeCommand}" />
                    <TextBlock VerticalAlignment="Bottom" Margin="8,0,0,8" Style="{StaticResource AeCaption}"><Run Text="Active: " /><Run Text="{x:Bind ViewModel.ActiveCursorScheme, Mode=OneWay}" /></TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="More Windows personalization" Style="{StaticResource AeSectionTitle}" />
            <Border Style="{StaticResource AeCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Windows doesn't offer desktop apps a supported way to change the lock screen image, system sounds or the system font. These open the Windows settings pages instead." Style="{StaticResource AeCaption}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource AeButton}" Content="Lock screen" Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}" CommandParameter="ms-settings:lockscreen" />
                        <Button Style="{StaticResource AeButton}" Content="Sounds" Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}" CommandParameter="ms-settings:sound" />
                        <Button Style="{StaticResource AeButton}" Content="Fonts" Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}" CommandParameter="ms-settings:fonts" />
                        <Button Style="{StaticResource AeButton}" Content="Text cursor" Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}" CommandParameter="ms-settings:easeofaccess-cursor" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Related mods" Style="{StaticResource AeSectionTitle}" />
            <ctl:ModCardsView x:Name="Mods" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
