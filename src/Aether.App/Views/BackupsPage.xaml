<UserControl x:Class="Aether.App.Views.BackupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Aether.App"
    xmlns:ctl="using:Aether.App.Controls"
    xmlns:vm="using:Aether.Presentation.ViewModels"
    xmlns:items="using:Aether.Presentation.Items"
    xmlns:diag="using:Aether.Core.Diagnostics">
    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" Spacing="14">
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="AETHER backups vs. Windows restore points"
                     Message="AETHER backups save AETHER's own configuration (settings, themes, widgets, rules, mod configurations). A Windows restore point is a separate System Restore snapshot that only Windows can create — AETHER reports exactly whether it succeeded." />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource AeCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Create a backup" Style="{StaticResource AeSectionTitle}" Margin="0" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox Header="Contents" ItemsSource="{x:Bind ViewModel.Kinds}" SelectedItem="{x:Bind ViewModel.NewKind, Mode=TwoWay}" Width="150" />
                            <TextBox Header="Description" Text="{x:Bind ViewModel.NewDescription, Mode=TwoWay}" Width="240" Style="{StaticResource AeTextBox}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AeAccentButton}" Content="Back up now" Command="{x:Bind ViewModel.CreateCommand}" />
                            <Button Style="{StaticResource AeButton}" Content="Import backup…" Command="{x:Bind ViewModel.ImportCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AeCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Schedule and safety" Style="{StaticResource AeSectionTitle}" Margin="0" />
                        <ToggleSwitch Header="Scheduled backups" IsOn="{x:Bind ViewModel.Scheduled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <NumberBox Header="Every (hours)" Value="{x:Bind ViewModel.IntervalHours, Mode=TwoWay}" Minimum="1" Maximum="720" SpinButtonPlacementMode="Compact" Width="140" />
                            <NumberBox Header="Keep automatic" Value="{x:Bind ViewModel.Keep, Mode=TwoWay}" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" Width="140" />
                        </StackPanel>
                        <ToggleSwitch Header="Back up before high-impact mods" IsOn="{x:Bind ViewModel.BackupBeforeRisky, Mode=TwoWay}" />
                        <Button Style="{StaticResource AeButton}" Content="Create Windows restore point…" Command="{x:Bind ViewModel.CreateRestorePointCommand}" Visibility="{x:Bind ViewModel.RestorePointsSupported}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="Backups" Style="{StaticResource AeSectionTitle}" />
            <TextBlock Text="No backups yet." Style="{StaticResource AeMuted}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Backups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackupItem">
                        <Border Style="{StaticResource AeCard}" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Description}" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                                    <TextBlock Style="{StaticResource AeMuted}"><Run Text="{x:Bind Kind}" /><Run Text=" · " /><Run Text="{x:Bind Created}" /><Run Text=" · " /><Run Text="{x:Bind Size}" /><Run Text=" · " /><Run Text="{x:Bind Origin}" /></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource AeAccentButton}" Content="Restore" Click="OnRestore" Tag="{x:Bind}" />
                                    <Button Style="{StaticResource AeButton}" Content="Verify" Click="OnVerify" Tag="{x:Bind}" />
                                    <Button Style="{StaticResource AeButton}" Content="Export" Click="OnExport" Tag="{x:Bind}" />
                                    <Button Style="{StaticResource AeGhostButton}" Click="OnDelete" Tag="{x:Bind}"><FontIcon Glyph="&#xE74D;" FontSize="13" FontFamily="{StaticResource AeIcons}" /></Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid>
                <TextBlock Text="Change history" Style="{StaticResource AeSectionTitle}" />
                <TextBox HorizontalAlignment="Right" Width="260" PlaceholderText="Filter" Text="{x:Bind ViewModel.HistoryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AeTextBox}" />
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="diag:AuditEntry">
                        <Grid Padding="0,5" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind app:B.Time(Timestamp)}" Style="{StaticResource AeMuted}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource AeCaption}"><Run Text="{x:Bind Category}" /><Run Text="/" /><Run Text="{x:Bind Action}" /></TextBlock>
                            <TextBlock Grid.Column="2" Style="{StaticResource AeCaption}" Foreground="{StaticResource AeText}" MaxLines="2" TextTrimming="CharacterEllipsis"><Run Text="{x:Bind Subject}" /><Run Text="  " /><Run Text="{x:Bind Details}" /></TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
