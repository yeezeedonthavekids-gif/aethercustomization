<UserControl x:Class="Aether.App.Views.ThemesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Aether.App"
    xmlns:ctl="using:Aether.App.Controls"
    xmlns:vm="using:Aether.Presentation.ViewModels"
    xmlns:items="using:Aether.Presentation.Items">
    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AeButton}" Content="Import theme…" Command="{x:Bind ViewModel.ImportCommand}" />
                <Button Style="{StaticResource AeButton}" Content="Undo last theme" Command="{x:Bind ViewModel.RollbackCommand}" Visibility="{x:Bind ViewModel.CanRollback, Mode=OneWay}" />
            </StackPanel>
            <GridView ItemsSource="{x:Bind ViewModel.Themes}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemeItem">
                        <Grid Width="272" Height="226" CornerRadius="16" BorderBrush="{StaticResource AeBorder}" BorderThickness="1" Background="{x:Bind app:B.Brush(Background)}">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <!-- Mini preview -->
                            <Grid Margin="14,14,14,6" CornerRadius="10" Background="{x:Bind app:B.Brush(Gradient)}">
                                <Border Width="60" Margin="8" HorizontalAlignment="Left" CornerRadius="8" Background="{x:Bind app:B.Brush(Surface)}" />
                                <StackPanel Margin="80,12,12,12" Spacing="6">
                                    <Border Height="10" Width="90" HorizontalAlignment="Left" CornerRadius="4" Background="{x:Bind app:B.Brush(Text)}" Opacity="0.85" />
                                    <Border Height="7" Width="120" HorizontalAlignment="Left" CornerRadius="3" Background="{x:Bind app:B.Brush(Muted)}" />
                                    <Border Height="34" CornerRadius="8" Background="{x:Bind app:B.Brush(Surface)}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Height="16" Width="44" CornerRadius="6" Background="{x:Bind app:B.Brush(Accent)}" />
                                        <Border Height="16" Width="30" CornerRadius="6" Background="{x:Bind app:B.Brush(Accent2)}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Padding="14,4,14,12">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{x:Bind app:B.Brush(Text)}" />
                                    <TextBlock Foreground="{x:Bind app:B.Brush(Muted)}" FontSize="12"><Run Text="{x:Bind ModeLabel}" /><Run Text=" · " /><Run Text="{x:Bind Author}" /></TextBlock>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" Padding="8,2" Background="{x:Bind app:B.Brush(Accent)}" Visibility="{x:Bind IsActive, Mode=OneWay}">
                                    <TextBlock Text="Active" FontSize="11" Foreground="{x:Bind app:B.Brush(Background)}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Border Style="{StaticResource AeCard}" Visibility="{x:Bind app:B.ShowIf(ViewModel.Selected), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                    <TextBlock Text="{x:Bind ViewModel.Selected.Description, Mode=OneWay}" Style="{StaticResource AeCaption}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AeAccentButton}" Content="Apply theme" Command="{x:Bind ViewModel.ApplyCommand}" />
                        <Button Style="{StaticResource AeButton}" Content="Use in AETHER only" Command="{x:Bind ViewModel.PreviewInAppCommand}" />
                        <Button Style="{StaticResource AeButton}" Content="Duplicate" Command="{x:Bind ViewModel.DuplicateCommand}" />
                        <Button Style="{StaticResource AeButton}" Content="Edit" Command="{x:Bind ViewModel.BeginEditCommand}" />
                        <Button Style="{StaticResource AeButton}" Content="Export" Command="{x:Bind ViewModel.ExportCommand}" />
                        <Button Style="{StaticResource AeButton}" Content="Delete" Command="{x:Bind ViewModel.DeleteCommand}" Visibility="{x:Bind ViewModel.CanDelete, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AeCardElevated}" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Theme editor" Style="{StaticResource AeSectionTitle}" Margin="0" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox Header="Name" Text="{x:Bind ViewModel.EditName, Mode=TwoWay}" Width="220" Style="{StaticResource AeTextBox}" />
                        <TextBox Header="Description" Text="{x:Bind ViewModel.EditDescription, Mode=TwoWay}" Width="380" Style="{StaticResource AeTextBox}" />
                    </StackPanel>
                    <TextBlock Text="AETHER colors" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Header="Background" Text="{x:Bind ViewModel.EditBackground, Mode=TwoWay}" Width="120" />
                        <TextBox Header="Gradient" Text="{x:Bind ViewModel.EditGradient, Mode=TwoWay}" Width="120" />
                        <TextBox Header="Surface" Text="{x:Bind ViewModel.EditSurface, Mode=TwoWay}" Width="120" />
                        <TextBox Header="Accent" Text="{x:Bind ViewModel.EditAccent, Mode=TwoWay}" Width="120" />
                        <TextBox Header="Accent 2" Text="{x:Bind ViewModel.EditAccent2, Mode=TwoWay}" Width="120" />
                        <TextBox Header="Text" Text="{x:Bind ViewModel.EditText, Mode=TwoWay}" Width="120" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ToggleSwitch Header="Dark palette" IsOn="{x:Bind ViewModel.EditIsDark, Mode=TwoWay}" />
                        <Slider Header="Glass opacity" Minimum="0.3" Maximum="1" StepFrequency="0.02" Value="{x:Bind ViewModel.EditGlass, Mode=TwoWay}" Width="200" />
                        <TextBox Header="Font" Text="{x:Bind ViewModel.EditFont, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <TextBlock Text="Windows settings" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox Header="App mode" ItemsSource="{x:Bind ViewModel.Modes}" SelectedItem="{x:Bind ViewModel.EditAppsMode, Mode=TwoWay}" Width="140" />
                        <ComboBox Header="Windows mode" ItemsSource="{x:Bind ViewModel.Modes}" SelectedItem="{x:Bind ViewModel.EditSystemMode, Mode=TwoWay}" Width="140" />
                        <ToggleSwitch Header="Transparency" IsOn="{x:Bind ViewModel.EditTransparency, Mode=TwoWay}" />
                        <ToggleSwitch Header="Apply accent to Windows" IsOn="{x:Bind ViewModel.EditApplyAccent, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox Header="Wallpaper" Text="{x:Bind ViewModel.EditWallpaper, Mode=TwoWay}" Width="320" />
                        <Button Style="{StaticResource AeButton}" Content="Browse…" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickWallpaperCommand}" />
                        <ComboBox Header="Fit" ItemsSource="{x:Bind ViewModel.Fits}" SelectedItem="{x:Bind ViewModel.EditFit, Mode=TwoWay}" Width="120" />
                        <ComboBox Header="Cursor scheme" ItemsSource="{x:Bind ViewModel.CursorSchemes}" SelectedItem="{x:Bind ViewModel.EditCursor, Mode=TwoWay}" Width="200" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox Header="Taskbar profile" ItemsSource="{x:Bind ViewModel.TaskbarProfiles}" SelectedItem="{x:Bind ViewModel.EditTaskbarProfile, Mode=TwoWay}" Width="180" />
                        <ComboBox Header="Launcher layout" ItemsSource="{x:Bind ViewModel.StartProfiles}" SelectedItem="{x:Bind ViewModel.EditStartProfile, Mode=TwoWay}" Width="180" />
                        <ComboBox Header="Widget layout" ItemsSource="{x:Bind ViewModel.WidgetLayouts}" SelectedItem="{x:Bind ViewModel.EditWidgetLayout, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AeAccentButton}" Content="Save theme" Command="{x:Bind ViewModel.SaveEditCommand}" />
                        <Button Style="{StaticResource AeButton}" Content="Cancel" Command="{x:Bind ViewModel.CancelEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Theme schedule" Style="{StaticResource AeSectionTitle}" />
            <Border Style="{StaticResource AeCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Switch between two themes automatically. Sunrise/sunset uses the location in Settings ▸ General." Style="{StaticResource AeCaption}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ToggleSwitch Header="Enabled" IsOn="{x:Bind ViewModel.ScheduleEnabled, Mode=TwoWay}" />
                        <ToggleSwitch Header="Follow sunrise and sunset" IsOn="{x:Bind ViewModel.ScheduleSun, Mode=TwoWay}" />
                        <ComboBox Header="Day theme" ItemsSource="{x:Bind ViewModel.Themes}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.LightTheme, Mode=TwoWay}" Width="170" />
                        <TextBox Header="From" Text="{x:Bind ViewModel.LightAt, Mode=TwoWay}" Width="80" />
                        <ComboBox Header="Night theme" ItemsSource="{x:Bind ViewModel.Themes}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.DarkTheme, Mode=TwoWay}" Width="170" />
                        <TextBox Header="From" Text="{x:Bind ViewModel.DarkAt, Mode=TwoWay}" Width="80" />
                    </StackPanel>
                    <Button Style="{StaticResource AeAccentButton}" Content="Save schedule" Command="{x:Bind ViewModel.SaveScheduleCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
