<Window
    x:Class="Aether.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Aether.App"
    xmlns:vm="using:Aether.Presentation.ViewModels"
    Title="AETHER">

    <Grid x:Name="Root" Background="{StaticResource AeBackdropGradient}">
        <!-- Ambient glow -->
        <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-420,-300,0" Opacity="0.22" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{Binding Color, Source={StaticResource AeAccent}}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Padding="16,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource AeAccentGradient}" VerticalAlignment="Center">
                <TextBlock Text="Æ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AeOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="AETHER" FontWeight="SemiBold" CharacterSpacing="200" FontSize="12" Foreground="{StaticResource AeTextSecondary}" VerticalAlignment="Center" />
            <Button x:Name="SearchBox" Grid.Column="2" HorizontalAlignment="Center" Width="420" Height="32" CornerRadius="10" Padding="12,0"
                    HorizontalContentAlignment="Stretch" Background="{StaticResource AeSurfaceHover}" BorderBrush="{StaticResource AeBorder}"
                    Command="{x:Bind Shell.OpenPaletteCommand}">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE721;" FontSize="13" FontFamily="{StaticResource AeIcons}" Foreground="{StaticResource AeTextMuted}" />
                        <TextBlock Text="Search settings, mods, apps and commands" FontSize="13" Foreground="{StaticResource AeTextMuted}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Style="{StaticResource AeChip}" Padding="6,1">
                        <TextBlock x:Name="PaletteHint" Text="Ctrl+Space" FontSize="11" Foreground="{StaticResource AeTextSecondary}" />
                    </Border>
                </Grid>
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Style="{StaticResource AeChip}" Visibility="{x:Bind Shell.IsAdministrator}">
                    <TextBlock Text="Administrator" FontSize="11" Foreground="{StaticResource AeWarning}" />
                </Border>
                <Button Style="{StaticResource AeGhostButton}" ToolTipService.ToolTip="Notifications">
                    <Grid>
                        <FontIcon Glyph="&#xEA8F;" FontSize="15" FontFamily="{StaticResource AeIcons}" />
                        <Border Visibility="{x:Bind app:B.ShowCount(Shell.UnreadNotifications), Mode=OneWay}" Width="8" Height="8" CornerRadius="4"
                                Background="{StaticResource AeAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout Opened="OnNotificationsOpened">
                            <Grid Width="360" RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="Notifications" Style="{StaticResource AeSectionTitle}" Margin="0" />
                                    <HyperlinkButton HorizontalAlignment="Right" Content="Clear" Command="{x:Bind Shell.ClearNotificationsCommand}" />
                                </Grid>
                                <ListView Grid.Row="1" MaxHeight="420" ItemsSource="{x:Bind Shell.NotificationHistory}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToastViewModel">
                                            <StackPanel Padding="0,6" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Message}" Style="{StaticResource AeCaption}" MaxLines="4" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Padding="12,4,8,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource AeGhostButton}" Command="{x:Bind Shell.ToggleSidebarCommand}" ToolTipService.ToolTip="Collapse or expand the sidebar" Height="36">
                        <FontIcon Glyph="&#xE700;" FontSize="15" FontFamily="{StaticResource AeIcons}" />
                    </Button>
                    <TextBox x:Name="NavSearch" Grid.Column="1" PlaceholderText="Filter pages" Text="{x:Bind Shell.NavFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AeTextBox}" Visibility="{x:Bind app:B.Hide(Shell.IsCompact), Mode=OneWay}" />
                </Grid>
                <ListView x:Name="NavList" Grid.Row="1" ItemsSource="{x:Bind Shell.NavItems}" SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="OnNavClick" Padding="0" TabNavigation="Once">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItemViewModel">
                            <Grid Padding="10,8" ColumnSpacing="14" ToolTipService.ToolTip="{x:Bind Description}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="3" Height="18" CornerRadius="2" Background="{StaticResource AeAccentGradient}" Margin="-10,0,0,0" HorizontalAlignment="Left"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" FontFamily="{StaticResource AeIcons}" Foreground="{StaticResource AeText}" Opacity="{x:Bind app:B.Opacity(IsSelected), Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource AeText}" Opacity="{x:Bind app:B.Opacity(IsSelected), Mode=OneWay}" />
                                <Border Grid.Column="2" Style="{StaticResource AeChip}" Visibility="{x:Bind HasBadge, Mode=OneWay}" Padding="6,0">
                                    <TextBlock Text="{x:Bind Badge, Mode=OneWay}" FontSize="11" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" Style="{StaticResource AeCard}" Padding="12" Visibility="{x:Bind app:B.Hide(Shell.IsCompact), Mode=OneWay}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Your Windows. Your Rules." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                        <TextBlock Text="{x:Bind Shell.WindowsLabel}" Style="{StaticResource AeMuted}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Content -->
            <Grid Grid.Column="1" Margin="0,0,10,10" CornerRadius="18" Background="{StaticResource AeSurface}" BorderBrush="{StaticResource AeBorder}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="36,26,36,10" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource AeGhostButton}" Command="{x:Bind Shell.GoBackCommand}" Visibility="{x:Bind Shell.CanGoBack, Mode=OneWay}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" FontFamily="{StaticResource AeIcons}" />
                    </Button>
                    <Border Grid.Column="1" Width="46" Height="46" CornerRadius="14" Background="{StaticResource AeAccentGradient}">
                        <FontIcon Glyph="{x:Bind Shell.PageGlyph, Mode=OneWay}" FontSize="21" FontFamily="{StaticResource AeIcons}" Foreground="{StaticResource AeOnAccent}" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="AETHER" Style="{StaticResource AeMuted}" />
                            <TextBlock Text="›" Style="{StaticResource AeMuted}" />
                            <TextBlock Text="{x:Bind Shell.PageTitle, Mode=OneWay}" Style="{StaticResource AeMuted}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Shell.PageTitle, Mode=OneWay}" Style="{StaticResource AePageTitle}" />
                        <TextBlock Text="{x:Bind Shell.PageDescription, Mode=OneWay}" Style="{StaticResource AeCaption}" />
                    </StackPanel>
                </Grid>
                <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.ContentTransitions>
                        <TransitionCollection>
                            <ContentThemeTransition VerticalOffset="18" />
                        </TransitionCollection>
                    </ContentControl.ContentTransitions>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- Toasts -->
        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Shell.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Width="380">
            <ItemsControl.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="60" />
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </ItemsControl.ItemContainerTransitions>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToastViewModel">
                    <Border Margin="0,8,0,0" Padding="14" CornerRadius="14" Background="{StaticResource AeSurfaceElevated}" BorderBrush="{StaticResource AeBorder}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" FontFamily="{StaticResource AeIcons}" Foreground="{StaticResource AeAccent}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                                <TextBlock Text="{x:Bind Message}" Style="{StaticResource AeCaption}" MaxLines="6" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Command palette -->
        <Grid x:Name="PaletteOverlay" Grid.RowSpan="2" Visibility="{x:Bind Shell.Palette.IsOpen, Mode=OneWay}" Background="#66000000" Tapped="OnPaletteBackdropTapped">
            <Border Width="680" MaxHeight="560" VerticalAlignment="Top" Margin="0,90,0,0" CornerRadius="18" Background="{StaticResource AeSurfaceElevated}"
                    BorderBrush="{StaticResource AeBorder}" BorderThickness="1" Padding="10" Tapped="OnPaletteTapped">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PaletteBox" PlaceholderText="Type a command, setting, mod, app or theme…" FontSize="17" Padding="14,10" CornerRadius="12"
                             Text="{x:Bind Shell.Palette.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnPaletteKeyDown" />
                    <ListView x:Name="PaletteList" Grid.Row="1" ItemsSource="{x:Bind Shell.Palette.Results}" SelectedIndex="{x:Bind Shell.Palette.SelectedIndex, Mode=TwoWay}"
                              IsItemClickEnabled="True" ItemClick="OnPaletteItemClick" MaxHeight="420">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteResult">
                                <Grid Padding="4,8" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AeAccentSoft}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" FontFamily="{StaticResource AeIcons}" Foreground="{StaticResource AeAccent}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource AeText}" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource AeMuted}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Category}" Style="{StaticResource AeMuted}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="8,0,8,4">
                        <TextBlock Text="↑↓ to move" Style="{StaticResource AeMuted}" />
                        <TextBlock Text="Enter to run" Style="{StaticResource AeMuted}" />
                        <TextBlock Text="Esc to close" Style="{StaticResource AeMuted}" />
                        <TextBlock Text="No matches." Style="{StaticResource AeMuted}" Visibility="{x:Bind Shell.Palette.HasNoResults, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Onboarding -->
        <ContentControl x:Name="OnboardingHost" Grid.RowSpan="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
    </Grid>
</Window>
