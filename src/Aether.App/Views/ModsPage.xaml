<UserControl x:Class="Aether.App.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Aether.App"
    xmlns:ctl="using:Aether.App.Controls"
    xmlns:vm="using:Aether.Presentation.ViewModels"
    xmlns:items="using:Aether.Presentation.Items"
    xmlns:man="using:Aether.ModEngine.Manifest"
    xmlns:storage="using:Aether.Storage">
    <Grid Padding="36,8,24,24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>
        <Grid RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Search mods" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AeTextBox}" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" MinWidth="170" />
                <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.Filters}" SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}" MinWidth="120" />
                <Button Grid.Column="3" Style="{StaticResource AeButton}" Content="More">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Install from file…" Command="{x:Bind ViewModel.InstallFromFileCommand}" />
                            <MenuFlyoutItem Text="Export configuration…" Command="{x:Bind ViewModel.ExportConfigurationCommand}" />
                            <MenuFlyoutItem Text="Import configuration…" Command="{x:Bind ViewModel.ImportConfigurationCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Installation log" Command="{x:Bind ViewModel.ShowLogCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Mods}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="14" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="items:ModItemViewModel">
                        <Border Style="{StaticResource AeCard}" Padding="14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AeAccentSoft}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" FontFamily="{StaticResource AeIcons}" Foreground="{StaticResource AeAccent}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{StaticResource AeText}" />
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource AeCaption}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <Border Style="{StaticResource AeChip}"><TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" /></Border>
                                        <Border Style="{StaticResource AeChip}" Background="{StaticResource AeSurfaceHover}"><TextBlock Text="{x:Bind CategoryLabel}" FontSize="11" /></Border>
                                        <TextBlock Text="{x:Bind RuntimeStatus, Mode=OneWay}" Style="{StaticResource AeMuted}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ProgressRing Width="18" Height="18" IsActive="{x:Bind IsWorking, Mode=OneWay}" />
                                    <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=OneWay}" Toggled="OnToggle" Tag="{x:Bind}" OnContent="" OffContent="" MinWidth="0" IsEnabled="{x:Bind IsCompatible}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE74C;" FontSize="40" FontFamily="{StaticResource AeIcons}" Foreground="{StaticResource AeTextMuted}" />
                <TextBlock Text="No mods match your filters." Style="{StaticResource AeCaption}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Detail -->
        <Border Grid.Column="1" Style="{StaticResource AeCardElevated}" Padding="0">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind app:B.Hide(ViewModel.HasSelection), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="36" FontFamily="{StaticResource AeIcons}" Foreground="{StaticResource AeTextMuted}" />
                    <TextBlock Text="Select a mod to configure it" Style="{StaticResource AeCaption}" />
                </StackPanel>
                <ScrollViewer Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Padding="22" Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AeText}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource AeMuted}"><Run Text="{x:Bind ViewModel.Selected.Author, Mode=OneWay}" /><Run Text=" · v" /><Run Text="{x:Bind ViewModel.Selected.Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.Selected.VerificationText, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.Selected.Description, Mode=OneWay}" Style="{StaticResource AeCaption}" />
                        </StackPanel>
                        <InfoBar IsOpen="{x:Bind ViewModel.Selected.HasError, Mode=OneWay}" Severity="Error" Title="Needs attention" Message="{x:Bind ViewModel.Selected.LastError, Mode=OneWay}" IsClosable="False" />
                        <InfoBar IsOpen="{x:Bind ViewModel.SelectedIncompatible, Mode=OneWay}" Severity="Warning" Title="Not compatible" Message="{x:Bind ViewModel.Selected.CompatibilitySummary, Mode=OneWay}" IsClosable="False" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.Mod.Manifest.Actions, Mode=OneWay}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="man:ModAction">
                                    <Button Style="{StaticResource AeAccentButton}" Content="{x:Bind Label}" Click="OnAction" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind Description}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Settings" Style="{StaticResource AeSectionTitle}" Margin="0" />
                        <ctl:SettingsFormView x:Name="Form" Form="{x:Bind ViewModel.Form, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AeAccentButton}" Content="Save settings" Command="{x:Bind ViewModel.SaveSettingsCommand}" />
                            <Button Style="{StaticResource AeButton}" Content="Reset to defaults" Command="{x:Bind ViewModel.ResetSettingsCommand}" />
                        </StackPanel>
                        <Expander Header="What will change" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" Style="{StaticResource AeCaption}" Margin="0,2" FontFamily="Cascadia Mono, Consolas" FontSize="12" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <Expander Header="Permissions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedPermissions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="man:PermissionInfo">
                                        <StackPanel Margin="0,4" Spacing="1">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource AeText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource AeCaption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <Expander Header="Documentation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.Selected.Mod.Manifest.Documentation.WhatItChanges, Mode=OneWay}" Style="{StaticResource AeCaption}" />
                                <TextBlock Text="{x:Bind ViewModel.Selected.Mod.Manifest.Documentation.Uninstall, Mode=OneWay}" Style="{StaticResource AeCaption}" />
                                <TextBlock Text="{x:Bind ViewModel.Selected.Mod.Manifest.Documentation.Limitations, Mode=OneWay}" Style="{StaticResource AeCaption}" />
                                <TextBlock Text="{x:Bind ViewModel.Selected.Mod.Manifest.Compatibility.Notes, Mode=OneWay}" Style="{StaticResource AeCaption}" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="History" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="storage:ModHistoryRecord">
                                        <TextBlock Style="{StaticResource AeCaption}" Margin="0,2"><Run Text="{x:Bind app:B.Time(Timestamp)}" /><Run Text="  " /><Run Text="{x:Bind Action}" /><Run Text="  " /><Run Text="{x:Bind Details}" /></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <Expander Header="Previous versions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind app:B.ShowCount(ViewModel.StoredVersions.Count), Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.StoredVersions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String"><Button Style="{StaticResource AeButton}" Content="{x:Bind}" Click="OnRestoreVersion" Tag="{x:Bind}" Margin="0,2" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <Button Style="{StaticResource AeButton}" Content="Uninstall" Command="{x:Bind ViewModel.UninstallCommand}" Visibility="{x:Bind ViewModel.CanUninstall, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
