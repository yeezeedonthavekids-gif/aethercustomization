<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes are mutated at runtime by ThemeResources when the AETHER theme changes. -->
    <SolidColorBrush x:Key="AeBackground" Color="#FF070B16" />
    <SolidColorBrush x:Key="AeBackground2" Color="#FF151B3A" />
    <SolidColorBrush x:Key="AeSurface" Color="#CC10162A" />
    <SolidColorBrush x:Key="AeSurfaceSolid" Color="#FF10162A" />
    <SolidColorBrush x:Key="AeSurfaceElevated" Color="#E6182041" />
    <SolidColorBrush x:Key="AeSurfaceHover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="AeBorder" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AeText" Color="#FFF2F5FF" />
    <SolidColorBrush x:Key="AeTextSecondary" Color="#FFB4BDD8" />
    <SolidColorBrush x:Key="AeTextMuted" Color="#FF6E7899" />
    <SolidColorBrush x:Key="AeAccent" Color="#FF7C8CFF" />
    <SolidColorBrush x:Key="AeAccent2" Color="#FFB37CFF" />
    <SolidColorBrush x:Key="AeAccentSoft" Color="#337C8CFF" />
    <SolidColorBrush x:Key="AeOnAccent" Color="#FF070B16" />
    <SolidColorBrush x:Key="AeSuccess" Color="#FF3DDC97" />
    <SolidColorBrush x:Key="AeWarning" Color="#FFFFB547" />
    <SolidColorBrush x:Key="AeDanger" Color="#FFFF5C7A" />
    <LinearGradientBrush x:Key="AeAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7C8CFF" Offset="0" />
        <GradientStop Color="#FFB37CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AeBackdropGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF070B16" Offset="0" />
        <GradientStop Color="#FF151B3A" Offset="1" />
    </LinearGradientBrush>

    <!-- Override a few WinUI brushes so standard controls pick up the accent. -->
    <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="AeAccent" />
    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AeAccent" />
    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AeAccent2" />
    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AeAccent" />
    <StaticResource x:Key="SliderThumbBackground" ResourceKey="AeAccent" />

    <x:Double x:Key="AeRadius">16</x:Double>
    <CornerRadius x:Key="AeCorner">16</CornerRadius>
    <CornerRadius x:Key="AeCornerSmall">10</CornerRadius>
    <FontFamily x:Key="AeIcons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

    <Style x:Key="AeCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AeSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource AeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AeCorner}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="AeCardElevated" TargetType="Border" BasedOn="{StaticResource AeCard}">
        <Setter Property="Background" Value="{StaticResource AeSurfaceElevated}" />
    </Style>

    <Style x:Key="AePageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AeText}" />
        <Setter Property="CharacterSpacing" Value="-20" />
    </Style>

    <Style x:Key="AeSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AeText}" />
        <Setter Property="Margin" Value="0,8,0,10" />
    </Style>

    <Style x:Key="AeBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource AeText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AeCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource AeTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AeMuted" TargetType="TextBlock" BasedOn="{StaticResource AeCaption}">
        <Setter Property="Foreground" Value="{StaticResource AeTextMuted}" />
    </Style>

    <Style x:Key="AeIcon" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource AeIcons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource AeText}" />
    </Style>

    <Style x:Key="AeAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="{StaticResource AeAccent}" />
        <Setter Property="Foreground" Value="{StaticResource AeOnAccent}" />
    </Style>

    <Style x:Key="AeButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Background" Value="{StaticResource AeSurfaceHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource AeBorder}" />
        <Setter Property="Foreground" Value="{StaticResource AeText}" />
    </Style>

    <Style x:Key="AeGhostButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AeTextSecondary}" />
    </Style>

    <Style x:Key="AeChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AeAccentSoft}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="AeTextBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
</ResourceDictionary>
